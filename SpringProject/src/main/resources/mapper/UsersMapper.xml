<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project2.smartfactory.users.UsersMapper">

    <resultMap id="UsersResultMap" type="com.project2.smartfactory.users.Users">
        <id property="id" column="id" />
        <result property="username" column="username" />
        <result property="adminPasswordHash" column="admin_password_hash" />
        <result property="createDate" column="created_date" />
        <result property="updateDate" column="updated_date" />
    </resultMap>

    <select id="findByUsername" parameterType="string" resultMap="UsersResultMap">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <select id="findById" parameterType="int" resultMap="UsersResultMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <select id="count" resultType="long">
        SELECT count(*) FROM users
    </select>

    <insert id="save" parameterType="com.project2.smartfactory.users.Users" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, admin_password_hash, created_date, updated_date)
        VALUES (#{username}, #{adminPasswordHash}, #{createDate}, #{updateDate})
    </insert>

    <update id="update" parameterType="com.project2.smartfactory.users.Users">
        UPDATE users
        SET admin_password_hash = #{adminPasswordHash},
            updated_date = #{updateDate}
        WHERE id = #{id}
    </update>

</mapper>
